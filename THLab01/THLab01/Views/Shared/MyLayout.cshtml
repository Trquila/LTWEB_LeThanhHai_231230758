@model IEnumerable<THLab01.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container">
    <h2 class="mb-4">Danh sách sinh viên</h2>

    <!-- Các cách tạo link khác nhau -->
    <div class="mb-3">
        <!-- Cách 1: HTML thuần -->
        <a href="/Admin/Student/Add" class="btn btn-primary me-2">Create Student (HTML thuần)</a>

        <!-- Cách 2: HTML Tag Helper với asp-route -->
        <a asp-route="admin" asp-route-action="Add" class="btn btn-success me-2">Create Student (Tag Helper - Route)</a>

        <!-- Cách 3: HTML Tag Helper với asp-action -->
        <a asp-action="Create" class="btn btn-info">Create Student (Tag Helper - Action)</a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Mã</th>
                <th>Họ tên</th>
                <th>Ảnh đại diện</th>
                <th>Ngày sinh</th>
                <th>Ngành</th>
                <th>Giới tính</th>
                <th>Hệ ĐT</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.Avatar))
                        {
                            <img src="~/images/@s.Avatar" alt="Avatar" width="40" height="40"
                                 style="border-radius: 50%; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/images/default-avatar.png" alt="Default Avatar" width="40" height="40"
                                 style="border-radius: 50%; object-fit: cover;" />
                        }
                    </td>
                    <td>@s.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            string str = s.Branch switch
                            {
                                Branch.IT => "CNTT",
                                Branch.BE => "Kinh tế",
                                Branch.CE => "Công trình",
                                Branch.EE => "Điện - Điện tử",
                                _ => "Khác"
                            };
                        }
                    @str
                </td>
                <td>
                    @(s.Gender == Gender.Male ? "Nam" :
                                        s.Gender == Gender.Female ? "Nữ" : "Khác")
                </td>
                <td>
                    <span class="badge @(s.IsRegular ? "bg-success" : "bg-warning")">
                        @(s.IsRegular ? "Chính quy" : "Phi chính quy")
                    </span>
                </td>
                <td>@s.Address</td>
                <td>
                    <a href="mailto:@s.Email" class="text-decoration-none">@s.Email</a>
                </td>
            </tr>
                        }
        </tbody>
    </table>

    <!-- Thống kê -->
    <div class="mt-4 p-3 bg-light rounded">
        <h5>Thống kê:</h5>
        <div class="row">
            <div class="col-md-3">
                <strong>Tổng số sinh viên:</strong> @Model.Count()
            </div>
            <div class="col-md-3">
                <strong>Chính quy:</strong> @Model.Count(s => s.IsRegular)
            </div>
            <div class="col-md-3">
                <strong>Nam:</strong> @Model.Count(s => s.Gender == Gender.Male)
            </div>
            <div class="col-md-3">
                <strong>Nữ:</strong> @Model.Count(s => s.Gender == Gender.Female)
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Có thể thêm JavaScript cho trang index ở đây
        console.log("Student Index page loaded");
    </script>
}