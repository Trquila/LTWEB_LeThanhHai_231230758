@model List<CoffeeShop.Models.Product>
@{
    ViewData["Title"] = "Sản phẩm - Coffee Shop";
}

<div class="row">
    <!-- Sidebar -->
    <div class="col-md-3">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Danh mục</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("Index", "Product")" class="text-decoration-none">Tất cả sản phẩm</a></li>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Product", new { categoryId = category.Id })"
                               class="text-decoration-none @(ViewBag.CurrentCategory == category.Id ? "fw-bold text-primary" : "")">
                                @category.Name
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Products -->
    <div class="col-md-9">
        <!-- Search -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" action="@Url.Action("Index", "Product")">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control"
                               placeholder="Tìm kiếm sản phẩm..." value="@ViewBag.SearchTerm">
                        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="row">
            @if (Model.Count == 0)
            {
                <div class="col-12 text-center py-5">
                    <h4>Không tìm thấy sản phẩm nào</h4>
                    <p>Vui lòng thử lại với từ khóa khác hoặc danh mục khác.</p>
                </div>
            }
            else
            {
                foreach (var product in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 product-card">
                            <img src="~/uploads/products/@product.Image"
                                 class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text text-muted">@product.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="price fw-bold text-primary">@product.Price.ToString("N0") VND</span>
                                    <button class="btn btn-primary btn-sm add-to-cart"
                                            data-product-id="@product.Id">
                                        <i class="fas fa-cart-plus"></i> Thêm
                                    </button>
                                </div>
                            </div>
                            <div class="card-footer">
                                <a href="@Url.Action("Detail", "Product", new { id = product.Id })"
                                   class="btn btn-outline-primary btn-sm w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new { page = i, categoryId = ViewBag.CurrentCategory, search = ViewBag.SearchTerm })">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const addToCartButtons = document.querySelectorAll('.add-to-cart');

            addToCartButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    addToCart(productId);
                });
            });
        });

        function addToCart(productId) {
            fetch('@Url.Action("AddToCart", "Cart")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', data.message);
                } else {
                    showAlert('error', data.message);
                }
            });
        }

        function showAlert(type, message) {
            // Alert implementation
        }
    </script>
}