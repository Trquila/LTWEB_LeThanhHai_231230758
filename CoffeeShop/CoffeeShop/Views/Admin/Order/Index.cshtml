@model List<CoffeeShop.Models.Order>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Quản lý đơn hàng</h2>

    <div class="btn-group">
        <a href="@Url.Action("Index", "AdminOrder")"
           class="btn @(string.IsNullOrEmpty(ViewBag.Status) ? "btn-primary" : "btn-outline-primary")">
            Tất cả
        </a>
        <a href="@Url.Action("Index", "AdminOrder", new { status = "pending" })"
           class="btn @(ViewBag.Status == "pending" ? "btn-warning" : "btn-outline-warning")">
            Chờ xử lý
        </a>
        <a href="@Url.Action("Index", "AdminOrder", new { status = "confirmed" })"
           class="btn @(ViewBag.Status == "confirmed" ? "btn-info" : "btn-outline-info")">
            Đã xác nhận
        </a>
        <a href="@Url.Action("Index", "AdminOrder", new { status = "delivered" })"
           class="btn @(ViewBag.Status == "delivered" ? "btn-success" : "btn-outline-success")">
            Đã giao
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.CustomerName</td>
                            <td>@order.CustomerPhone</td>
                            <td>@order.TotalAmount.ToString("N0") VND</td>
                            <td>
                                <span class="badge
                                        @(order.Status == "pending" ? "bg-warning" :
                                                                            order.Status == "confirmed" ? "bg-info" :
                                                                            order.Status == "delivered" ? "bg-success" : "bg-danger")">
                                @order.Status
                            </span>
                        </td>
                        <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a href="@Url.Action("Detail", "AdminOrder", new { id = order.Id })"
                               class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>
</div>