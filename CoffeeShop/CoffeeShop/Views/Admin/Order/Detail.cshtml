@model CoffeeShop.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Chi tiết đơn hàng #@Model.Id</h2>
    <a href="@Url.Action("Index", "AdminOrder")" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Thông tin đơn hàng</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Mã đơn hàng:</th>
                        <td>#@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Khách hàng:</th>
                        <td>@Model.CustomerName</td>
                    </tr>
                    <tr>
                        <th>Số điện thoại:</th>
                        <td>@Model.CustomerPhone</td>
                    </tr>
                    <tr>
                        <th>Địa chỉ:</th>
                        <td>@Model.CustomerAddress</td>
                    </tr>
                    <tr>
                        <th>Ghi chú:</th>
                        <td>@(string.IsNullOrEmpty(Model.Notes) ? "Không có" : Model.Notes)</td>
                    </tr>
                    <tr>
                        <th>Tổng tiền:</th>
                        <td class="fw-bold text-primary">@Model.TotalAmount.ToString("N0") VND</td>
                    </tr>
                    <tr>
                        <th>Trạng thái:</th>
                        <td>
                            <span class="badge
                                @(Model.Status == "pending" ? "bg-warning" :
                                                                    Model.Status == "confirmed" ? "bg-info" :
                                                                    Model.Status == "delivered" ? "bg-success" : "bg-danger")">
                                @Model.Status
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Ngày đặt:</th>
                        <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Cập nhật trạng thái</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateStatus", "AdminOrder")">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">Trạng thái mới</label>
                        <select name="status" class="form-control">
                            <option value="pending" selected="@(Model.Status == "pending")">Chờ xử lý</option>
                            <option value="confirmed" selected="@(Model.Status == "confirmed")">Đã xác nhận</option>
                            <option value="delivered" selected="@(Model.Status == "delivered")">Đã giao</option>
                            <option value="cancelled" selected="@(Model.Status == "cancelled")">Đã hủy</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Cập nhật</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5>Chi tiết sản phẩm</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Price.ToString("N0") VND</td>
                            <td>@item.Quantity</td>
                            <td>@((item.Price * item.Quantity).ToString("N0")) VND</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
                        <td><strong>@Model.TotalAmount.ToString("N0") VND</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>